### Unity
# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Build output
*.apk
*.aab
*.unitypackage

# Autogenerated solution and project files
*.csproj
*.unityproj
*.sln
*.suo
game/Library
game/Temp
game/Logs
game/UserSettings

# Reference project credentials/config generated outside source control
game/Assets/liences_key.txt
game/Assets/liences_key.txt.meta
game/Assets/google-services.json
game/Assets/google-services.json.meta
game/Assets/StreamingAssets/google-services-desktop.json
game/Assets/StreamingAssets/google-services-desktop.json.meta
game/Assets/Plugins/Android/FirebaseApp.androidlib/res/values/google-services.xml
game/Assets/Editor/.idea
game/obj
game/WoolSortDebugLogs
